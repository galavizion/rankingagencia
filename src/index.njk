<script>
(function () {
  const CIRC = 201.1;
  const DURATION = 1400;

  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

  function animateRings() {
    document.querySelectorAll('.ring-arc').forEach(function (arc) {
      const pct    = parseInt(arc.dataset.target) / parseInt(arc.dataset.max);
      const target = CIRC * (1 - pct);
      const start  = performance.now();
      (function tick(now) {
        var progress = Math.min((now - start) / DURATION, 1);
        arc.style.strokeDashoffset = CIRC - (CIRC - target) * easeOutCubic(progress);
        if (progress < 1) requestAnimationFrame(tick);
      })(start);
    });

    document.querySelectorAll('.ring-count').forEach(function (el) {
      var target = parseInt(el.dataset.target);
      var start  = performance.now();
      (function tick(now) {
        var progress = Math.min((now - start) / DURATION, 1);
        el.textContent = Math.round(easeOutCubic(progress) * target);
        if (progress < 1) requestAnimationFrame(tick);
      })(start);
    });
  }

  var mockup = document.querySelector('.hero__mockup');
  if (!mockup) return;

  var observer = new IntersectionObserver(function (entries) {
    if (entries[0].isIntersecting) { animateRings(); observer.disconnect(); }
  }, { threshold: 0.4 });

  observer.observe(mockup);
})();
</script>
