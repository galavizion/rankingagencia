<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | Ranking Agencia</title>
  <meta name="description" content="{{ description or 'Infraestructura digital que hace ganar dinero. Desarrollo headless, SEO técnico y sistemas de IA con memoria contextual.' }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="icon" href="/assets/img/favicon.png" type="image/png" />
</head>
<body>

  <header class="site-header">
    <div class="container header__inner">
      <a href="/" class="logo">
        <span class="logo__rank">Ranking</span><span class="logo__agency">Agencia</span>
      </a>
      <nav class="nav">
        <a href="/#demos">Demos</a>
        <a href="/#casos">Casos</a>
        <a href="/#servicios">Servicios</a>
        <a href="/blog/">Blog</a>
        <a class="btn btn--nav" href="https://wa.me/528180000000?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20sus%20servicios" target="_blank" rel="noopener">Hablar con IA</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer__inner">
      <p class="footer__brand"><span class="logo__rank">Ranking</span><span class="logo__agency">Agencia</span></p>
      <p class="footer__copy">© {{ "now" | date("yyyy") }} Ranking Agencia · Monterrey, México</p>
      <nav class="footer__nav">
        <a href="/blog/">Blog</a>
        <a href="/#servicios">Servicios</a>
        <a href="https://wa.me/528180000000" target="_blank" rel="noopener">WhatsApp</a>
      </nav>
    </div>
  </footer>

</body>
</html>
