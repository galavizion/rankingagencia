---
import BaseLayout from "../layouts/BaseLayout.astro";
import Builder from "../components/builder/Builder.astro";
import { sanityFetch } from "../lib/sanity/client";
import { homeQuery } from "../lib/sanity/queries";
import LeadSimulator from "../components/LeadSimulator";

export const prerender = true;

const miSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Ranking Agencia",
  url: "https://www.rankingagencia.com/",
};

const page = await sanityFetch<any>({ query: homeQuery });
if (!page) throw new Error("No existe una página Home en Sanity (pageType=home).");
---

<BaseLayout title={page.title} seo={page.seo} schema={miSchema}>
  <main>
    <Builder sections={page.sections} />
    
    <section style="padding: 80px 20px; background: transparent; border-top: 1px solid rgba(255,255,255,0.05);">
      <div style="max-width: 1200px; margin: 0 auto;">
        <h2 style="text-align: center; font-size: clamp(28px, 4vw, 42px); font-weight: 900; margin-bottom: 10px; color: #fff;">
          El Simulador <span class="text-gradient">"Cajero Automático"</span>
        </h2>
        <p style="text-align: center; font-size: 18px; margin-bottom: 40px; color: rgba(255,255,255,0.6);">
          Mira cómo nuestra Inteligencia Artificial lee, entiende y extrae los datos clave de tu cliente en milisegundos.
        </p>
        
        <LeadSimulator client:visible />
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .anim-blink {
    animation: blink 1s step-end infinite;
  }
  .anim-pulse {
    animation: pulse 2s infinite;
  }
  .anim-fadeIn {
    animation: fadeIn 0.3s ease-in-out forwards;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.5; }
    100% { opacity: 1; }
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>