---
import BaseLayout from "../layouts/BaseLayout.astro";
import Builder from "../components/builder/Builder.astro";
import { sanityFetch } from "../lib/sanity/client";
import { homeQuery } from "../lib/sanity/queries";
import LeadSimulatorWrapper from "../components/LeadSimulator";

export const prerender = true;

const miSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Ranking Agencia",
  url: "https://www.rankingagencia.com/",
};

const page = await sanityFetch<any>({ query: homeQuery });
if (!page) throw new Error("No existe una página Home en Sanity (pageType=home).");
---

<BaseLayout title={page.title} seo={page.seo} schema={miSchema}>
  <main>
    <Builder sections={page.sections} />
    
    <section style="padding: 80px 20px; background: #fafafa; border-top: 1px solid #eaeaea;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <h2 style="text-align: center; font-size: 36px; font-weight: 900; margin-bottom: 10px; color: #111;">
          El Simulador "Cajero Automático"
        </h2>
        <p style="text-align: center; font-size: 18px; margin-bottom: 40px; color: #555;">
          Mira cómo nuestra Inteligencia Artificial lee, entiende y extrae los datos clave de tu cliente en milisegundos.
        </p>
        
        <LeadSimulatorWrapper client:visible />
      </div>
    </section>
  </main>
</BaseLayout>